{
  "name": "domaindetails",
  "version": "1.2.0",
  "description": "Domain information lookup tool - CLI, library, and MCP server. Look up RDAP, WHOIS, and comprehensive domain information.",
  "mcpName": "io.github.simplebytes-com/domaindetails-mcp",
  "main": "build/lib.js",
  "module": "build/lib.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/lib.js",
      "default": "./build/lib.js"
    },
    "./mcp": {
      "import": "./build/mcp-server.js",
      "default": "./build/mcp-server.js"
    }
  },
  "bin": {
    "domaindetails": "./build/cli.js",
    "domaindetails-mcp": "./build/mcp-server.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "prepare": "npm run build",
    "start": "node build/cli.js",
    "mcp": "node build/mcp-server.js"
  },
  "keywords": [
    "domain",
    "rdap",
    "whois",
    "dns",
    "domain-lookup",
    "domain-research",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "author": "SimpleBytes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplebytes-com/domaindetails-mcp.git"
  },
  "homepage": "https://github.com/simplebytes-com/domaindetails-mcp#readme",
  "bugs": {
    "url": "https://github.com/simplebytes-com/domaindetails-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
